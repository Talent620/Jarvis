{
  "appId": "net.serwer256.jarvis",
  "appName": "JARVIS",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
