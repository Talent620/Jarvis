# Pamięć długoterminowa JARVIS (Mem0 + Qdrant). Skopiuj do `.env` i uzupełnij.
# ZERO sekretów w repo — ten plik to tylko szablon.

# Klucz dla Mem0 (embeddingi + ekstrakcja faktów). Możesz użyć OpenAI albo skonfigurować innego.
OPENAI_API_KEY=

# Provider LLM/embedder dla Mem0 (domyślnie openai). Patrz dokumentacja Mem0 dla alternatyw.
MEM0_LLM_PROVIDER=openai
MEM0_EMBEDDER_PROVIDER=openai

# Token chroniący API pamięci. Wygeneruj losowy (np. openssl rand -hex 24).
# Ten sam token wpisz w JARVIS → ustawienia → memoryServiceToken.
MEM0_API_TOKEN=
