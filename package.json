{
  "name": "jarvis-ai-assistant",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "JARVIS — futurystyczny, agentowy asystent głosowy i tekstowy napędzany Claude Opus 4.8.",
  "author": "Artur Józefczak",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.cjs",
    "scan:secrets": "node scripts/secret-scan.mjs --all",
    "hooks": "git config core.hooksPath .githooks && echo '✅ Hook pre-commit aktywny (.githooks).'",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "android:build": "npm run build && cap sync android",
    "electron:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "salesos": "bash sales-os/start.sh",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor-community/contacts": "^6.1.1",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/app-launcher": "^6.0.2",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "@ebarooni/capacitor-calendar": "^6.7.2",
    "dexie": "^4.4.4",
    "framer-motion": "^11.18.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "send-intent": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.39.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
