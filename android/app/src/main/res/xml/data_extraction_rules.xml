<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Wyklucz dane WebView/baz/sharedpref (localStorage z kluczami
     i ustawieniami) zarówno z backupu w chmurze, jak i transferu między urządzeniami. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_webview" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
