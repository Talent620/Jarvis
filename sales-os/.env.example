# ---------------------------------------------------------------------------
# Database (PostgreSQL). With docker-compose this default works out of the box.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_sales_os?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
#   Generate a secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="please-change-me-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider — the app ships with a built-in deterministic MOCK provider, so
# it runs end-to-end with NO keys. Set AI_PROVIDER to openai or anthropic and
# add a key to use a real model.
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"                 # mock | openai | anthropic
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"             # e.g. claude-3-5-sonnet-latest for anthropic
AI_BASE_URL=""                     # optional override for compatible gateways

# ---------------------------------------------------------------------------
# Outbound lead discovery (optional). Without a key the app uses a built-in
# MOCK prospecting source (sample data) so discovery works out of the box.
# Add ONE of these to source real prospects from your ICP.
# ---------------------------------------------------------------------------
APOLLO_API_KEY=""                  # apollo.io people search
HUNTER_API_KEY=""                  # hunter.io domain search

# ----------------------------------------------------------------------
# Acquisition Autopilot
# ----------------------------------------------------------------------
# In-process scheduler that drives the autopilot during `npm run dev`.
# Set to "0" to disable (e.g. when you trigger /api/cron externally instead).
ACQUISITION_AUTOPILOT_INPROCESS="1"
# How often the in-process scheduler ticks, in seconds (min 30, default 300).
ACQUISITION_TICK_SECONDS="300"

# Secret protecting POST/GET /api/cron when triggered by an external scheduler
# (Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`). Required in
# production; in dev the endpoint is open when this is unset.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Lead Finder — local-business prospecting (optional; sample data without keys)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=""           # Google Places API (New) — finds businesses + tells if they have a website
CEIDG_API_TOKEN=""                 # JWT from dane.biznes.gov.pl — freshly registered Polish companies

# ---------------------------------------------------------------------------
# Website audits (PageSpeed Insights is free; key only raises the quota).
# Without a key the app first tries keyless PageSpeed, then a built-in probe.
# ---------------------------------------------------------------------------
PAGESPEED_API_KEY=""

# ---------------------------------------------------------------------------
# Email delivery — set ONE provider to send for real. Without keys, sends are
# SIMULATED (logged + marked "simulated") so every flow remains testable.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""                  # resend.com
MAILGUN_API_KEY=""                 # mailgun.com (with MAILGUN_DOMAIN)
MAILGUN_DOMAIN=""
EMAIL_FROM="Your Name <you@yourdomain.com>"

# ---------------------------------------------------------------------------
# Social publishing — Facebook / Instagram via Meta Graph API, Google Business
# Profile posts. Without tokens, publishing is SIMULATED (clearly labelled).
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=""               # long-lived Page token with pages_manage_posts
FACEBOOK_PAGE_ID=""
INSTAGRAM_BUSINESS_ID=""           # IG business account linked to the Page
GBP_ACCESS_TOKEN=""                # Google Business Profile OAuth token
GBP_LOCATION_ID=""                 # accounts/{accountId}/locations/{locationId}
