+    return report;
+  } };
+}
+function environment() {
+  return {
+    os: os.release(), platform: os.platform(), architecture: os.arch(), node: process.version,
+    os_release: fs.existsSync('/etc/os-release') ? fs.readFileSync('/etc/os-release', 'utf8') : null,
