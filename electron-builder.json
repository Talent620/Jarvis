{
  "appId": "net.serwer256.jarvis",
  "productName": "JARVIS",
  "directories": {
    "output": "release-desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "artifactName": "JARVIS.exe"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "public/icon-512.png",
    "category": "Utility;Office",
    "maintainer": "Talent620 <192472679+Talent620@users.noreply.github.com>",
    "artifactName": "JARVIS.${ext}",
    "desktop": {
      "Name": "JARVIS AI",
      "Comment": "Autonomiczny asystent AI (AutoCore, lokalna Ollama, MCP, głos i wizja)",
      "StartupWMClass": "JARVIS",
      "Keywords": "AI;Assistant;Voice;Ollama;MCP;JARVIS;"
    }
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JARVIS",
    "artifactName": "JARVIS.exe"
  },
  "extraResources": [
    {
      "from": "site-os",
      "to": "site-os",
      "filter": [
        "server.mjs",
        "public/**/*"
      ]
    }
  ]
}
