{
  "appId": "net.serwer256.jarvis",
  "productName": "JARVIS",
  "directories": {
    "output": "release-desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "artifactName": "JARVIS.exe"
  },
  "linux": {
    "icon": "public/icon-512.png",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "Talent620 <192472679+Talent620@users.noreply.github.com>",
    "artifactName": "JARVIS.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JARVIS",
    "artifactName": "JARVIS.exe"
  },
  "extraResources": [
    {
      "from": "server/runtime",
      "to": "runtime",
      "filter": ["*.mjs"]
    },
    {
      "from": "site-os",
      "to": "site-os",
      "filter": [
        "server.mjs",
        "public/**/*"
      ]
    }
  ]
}
